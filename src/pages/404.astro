---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getDocs } from '~/lib/docs';
import { docPath, ui } from '~/lib/i18n';

// 404 只有一份，中英并排显示 —— 静态托管只认根目录的 404.html，
// 为它再分一套 /en 路由反而会让「找不到的页面」多一层找不到。
const zh = await getDocs('zh');
const en = await getDocs('en');
const picks = [
  ...zh.slice(0, 3).map((d) => ({ href: docPath('zh', d.id), title: d.data.title, group: d.data.group })),
  ...en.slice(0, 3).map((d) => ({ href: docPath('en', d.id), title: d.data.title, group: d.data.group })),
];
---

<BaseLayout
  locale="zh"
  title="404"
  description="这一页不存在 / This page does not exist."
  crumb={['404']}
  hideLangSwitch
>
  <main id="main">
    <div class="home">
      <section class="cover">
        <div class="cover__main" style="padding-block:88px 56px;">
          <p class="cover__kicker">{ui.zh.notFound.kicker}</p>
          <h1 class="cover__title">{ui.zh.notFound.title}</h1>
          <p class="cover__lede">{ui.zh.notFound.lede}</p>
          <div class="cover__cta">
            <a class="btn" href="/docs/intro">{ui.zh.notFound.home} <span aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href="/">{ui.zh.notFound.root}</a>
          </div>

          <div style="margin-top:56px; padding-top:32px; border-top:1px solid var(--rule);">
            <p class="cover__kicker">{ui.en.notFound.kicker}</p>
            <h2 class="cover__title" style="font-size:clamp(1.6rem,2.4vw,2.1rem); margin-top:16px;">
              {ui.en.notFound.title}
            </h2>
            <p class="cover__lede" style="margin-top:12px;">{ui.en.notFound.lede}</p>
            <div class="cover__cta">
              <a class="btn" href="/en/docs/intro">{ui.en.notFound.home} <span aria-hidden="true">→</span></a>
              <a class="btn btn--ghost" href="/en">{ui.en.notFound.root}</a>
            </div>
          </div>
        </div>

        <aside class="cover__aside">
          <p class="doc-kicker" style="margin-bottom:14px;">{ui.zh.notFound.recent}</p>
          <div class="doc-index" style="grid-template-columns:minmax(0,1fr);">
            {
              picks.map((item) => (
                <a class="doc-index__link" href={item.href}>
                  <span class="doc-index__name">{item.title}</span>
                  <span class="doc-index__meta">{item.group}</span>
                </a>
              ))
            }
          </div>
        </aside>
      </section>
    </div>
  </main>
</BaseLayout>
