---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import SearchDialog from '~/components/SearchDialog.astro';
import { site } from '~/lib/site';
import { alternate, ui, type Locale } from '~/lib/i18n';
import sansFont from '~/assets/fonts/instrument-sans-400.woff2?url';
import monoFont from '~/assets/fonts/jetbrains-mono-400.woff2?url';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** 顶栏中间那行面包屑，例如 ['参考', '加密选项'] */
  crumb?: string[];
  bodyClass?: string;
  /** 404 这类中英混排的页面不需要语言切换（另一边并不存在） */
  hideLangSwitch?: boolean;
}

const { locale, title, description, crumb, bodyClass, hideLangSwitch } = Astro.props;
const dict = ui[locale];

const fullTitle =
  title === site.name ? `${site.name} — ${locale === 'en' ? 'docs' : '文档'}` : `${title} — SealPack ${dict.crumbRoot}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const ogImage = new URL(locale === 'en' ? '/og-en.png' : '/og.png', Astro.site ?? site.url).href;

const zhHref = alternate(Astro.url.pathname, 'zh');
const enHref = alternate(Astro.url.pathname, 'en');
const toZh = new URL(zhHref, site.url).href;
const toEn = new URL(enHref, site.url).href;
---

<!doctype html>
<html lang={dict.htmlLang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? site.tagline[locale]} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="zh-CN" href={toZh} />
    <link rel="alternate" hreflang="en" href={toEn} />
    <link rel="alternate" hreflang="x-default" href={toZh} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`SealPack ${dict.crumbRoot}`} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? site.tagline[locale]} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17140f" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    {/* 首帧主题：必须在样式表之前跑完，否则暗色下会先闪一帧纸白 */}
    <script is:inline>
      (function () {
        var KEY = 'sealpack-docs:theme';
        var mode = 'auto';
        try {
          mode = localStorage.getItem(KEY) || 'auto';
        } catch (e) {
          /* 隐私模式下 localStorage 会抛错，退回自动 */
        }
        if (mode !== 'light' && mode !== 'dark') mode = 'auto';
        var dark =
          mode === 'dark' ||
          (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        var root = document.documentElement;
        root.dataset.theme = dark ? 'dark' : 'light';
        root.dataset.themeMode = mode;
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{dict.skip}</a>
    <Header locale={locale} crumb={crumb} hideLangSwitch={hideLangSwitch} />
    <slot />
    <Footer locale={locale} />
    <SearchDialog locale={locale} />
  </body>
</html>
