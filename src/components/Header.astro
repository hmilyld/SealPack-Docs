---
import { site } from '~/lib/site';
import { alternate, homePath, otherLocale, ui, type Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
  crumb?: string[];
  hideLangSwitch?: boolean;
}

const { locale, crumb, hideLangSwitch } = Astro.props;
const dict = ui[locale];
const trail = crumb && crumb.length > 0 ? crumb : [dict.crumbRoot];

// 语言切换：把当前路径映射到另一种语言下，首页与文档页都适用
const other = otherLocale(locale);
const switchHref = alternate(Astro.url.pathname, other);
const themeLabels = JSON.stringify(dict.theme);
---

<header class="site-header">
  <div class="site-header__inner">
    <div class="brand-cell">
      <a class="brand" href={homePath(locale)} aria-label={`SealPack ${dict.crumbRoot}`}>
        <svg class="brand__mark" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="1" y="1" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"></rect>
          <rect x="7" y="7" width="10" height="10"></rect>
        </svg>
        <span class="brand__name">SealPack</span>
        <span class="brand__suffix">{dict.brandSuffix}</span>
      </a>
    </div>

    <div class="crumb-cell">
      <span class="crumb">
        {
          trail.map((part, i) => (
            <>
              {i > 0 && <span class="crumb__sep"> / </span>}
              {i === trail.length - 1 ? <b>{part}</b> : part}
            </>
          ))
        }
      </span>
    </div>

    <div class="actions-cell">
      <button class="hbtn hbtn--box" type="button" data-search-open aria-label={dict.searchAria}>
        <span class="hbtn__label">{dict.search}</span>
        <kbd>Ctrl K</kbd>
      </button>
      <button
        class="hbtn"
        type="button"
        data-theme-toggle
        data-theme-labels={themeLabels}
        data-theme-aria={dict.themeAria('{label}')}
      >
        <span class="hbtn__dot" aria-hidden="true"></span>
        <span class="hbtn__label" data-theme-label>{dict.theme.auto}</span>
      </button>
      {
        !hideLangSwitch && (
          <a
            class="hbtn hbtn--box hbtn--lang"
            href={switchHref}
            hreflang={other === 'en' ? 'en' : 'zh-CN'}
            aria-label={dict.switchAria}
          >
            {dict.switchTo}
          </a>
        )
      }
      <a class="hbtn" href={site.repo} target="_blank" rel="noreferrer noopener">
        <span class="hbtn__label">GitHub</span><span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>

<script>
  const KEY = 'sealpack-docs:theme';
  const order = ['auto', 'light', 'dark'] as const;

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const labelEl = document.querySelector<HTMLElement>('[data-theme-label]');
  const mq = window.matchMedia('(prefers-color-scheme: dark)');

  const labels: Record<string, string> = JSON.parse(button?.dataset.themeLabels ?? '{}');
  const ariaTemplate = button?.dataset.themeAria ?? '{label}';

  function currentMode(): (typeof order)[number] {
    const m = root.dataset.themeMode;
    return m === 'light' || m === 'dark' ? m : 'auto';
  }

  function paint() {
    const label = labels[currentMode()] ?? currentMode();
    if (labelEl) labelEl.textContent = label;
    button?.setAttribute('aria-label', ariaTemplate.replace('{label}', label));
  }

  function setMode(next: (typeof order)[number]) {
    root.dataset.themeMode = next;
    try {
      if (next === 'auto') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, next);
    } catch {
      /* 存不了就只在本次会话生效 */
    }
    const dark = next === 'dark' || (next === 'auto' && mq.matches);
    root.dataset.theme = dark ? 'dark' : 'light';
    paint();
  }

  button?.addEventListener('click', () => {
    setMode(order[(order.indexOf(currentMode()) + 1) % order.length]!);
  });

  mq.addEventListener('change', () => {
    if (currentMode() === 'auto') setMode('auto');
  });

  paint();
</script>
