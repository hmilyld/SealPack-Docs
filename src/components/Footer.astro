---
import { site } from '~/lib/site';
import { ui, type Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = ui[locale];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <span>SEALPACK</span>
      <span aria-hidden="true">/</span>
      <span>{site.version}</span>
    </div>
    <p style="margin:0; max-width:58ch; line-height:1.7;">
      {dict.footerNote}
    </p>
    <div class="site-footer__links">
      <a href={site.forum} target="_blank" rel="noreferrer noopener">{dict.forum} ↗</a>
      <a href={site.repo} target="_blank" rel="noreferrer noopener">GitHub</a>
      <a href={site.releases} target="_blank" rel="noreferrer noopener">Releases</a>
      <a href={site.authorUrl} target="_blank" rel="noreferrer noopener">{site.author}</a>
      <span style="color:var(--faint)">{site.license}</span>
    </div>
  </div>
</footer>
