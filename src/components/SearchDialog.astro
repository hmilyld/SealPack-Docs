---
import { ui, type Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = ui[locale];
const endpoint = locale === 'en' ? '/en/search-index.json' : '/search-index.json';
---

<dialog
  class="search-dialog"
  id="search-dialog"
  aria-label={dict.searchAria}
  data-endpoint={endpoint}
  data-section-label={dict.headingSuffix}
>
  <div class="search-dialog__head">
    <span class="search-dialog__label">{dict.search}</span>
    <input
      class="search-dialog__input"
      type="search"
      placeholder={dict.searchPlaceholder}
      aria-label={dict.searchAria}
      autocomplete="off"
      spellcheck="false"
      data-search-input
    />
    <kbd class="kbd">Esc</kbd>
  </div>
  <p class="search-dialog__hint">{dict.searchHint}</p>
  <ul class="search-list" data-search-list role="listbox" aria-label={dict.searchAria}></ul>
  <p class="search-empty" data-search-empty hidden>{dict.searchEmpty}</p>
</dialog>

<script>
  type Item = {
    url: string;
    title: string;
    group: string;
    kind: 'page' | 'heading';
    text: string;
  };

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const list = document.querySelector<HTMLUListElement>('[data-search-list]');
  const empty = document.querySelector<HTMLElement>('[data-search-empty]');
  const endpoint = dialog?.dataset.endpoint ?? '/search-index.json';
  const sectionLabel = dialog?.dataset.sectionLabel ?? '';

  let index: Item[] | null = null;
  let loading: Promise<Item[]> | null = null;
  let results: Item[] = [];
  let cursor = 0;

  async function load(): Promise<Item[]> {
    if (index) return index;
    loading ??= fetch(endpoint)
      .then((r) => r.json() as Promise<Item[]>)
      .then((data) => {
        index = data;
        return data;
      })
      .catch(() => {
        index = [];
        return [] as Item[];
      });
    return loading;
  }

  function snippet(text: string, token: string): string {
    const at = text.toLowerCase().indexOf(token);
    if (at < 0) return text.slice(0, 72);
    const start = Math.max(0, at - 26);
    const end = Math.min(text.length, at + token.length + 46);
    return `${start > 0 ? '…' : ''}${text.slice(start, end).replace(/\s+/g, ' ')}${end < text.length ? '…' : ''}`;
  }

  function search(query: string): Item[] {
    const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);
    if (tokens.length === 0) {
      return (index ?? []).filter((i) => i.kind === 'page');
    }
    const scored: { item: Item; score: number }[] = [];
    for (const item of index ?? []) {
      const hay = `${item.title} ${item.text}`.toLowerCase();
      let score = 0;
      let ok = true;
      for (const token of tokens) {
        if (!hay.includes(token)) {
          ok = false;
          break;
        }
        if (item.title.toLowerCase().includes(token)) score += 12;
        if (item.kind === 'page') score += 2;
      }
      if (ok) scored.push({ item, score });
    }
    scored.sort((a, b) => b.score - a.score);
    return scored.slice(0, 14).map((s) => s.item);
  }

  function render(query: string) {
    if (!list) return;
    results = search(query);
    cursor = 0;
    list.replaceChildren();

    if (results.length === 0) {
      empty?.removeAttribute('hidden');
      return;
    }
    empty?.setAttribute('hidden', '');

    const token = query.trim().toLowerCase().split(/\s+/)[0] ?? '';

    results.forEach((item, i) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'search-item';
      a.href = item.url;
      a.setAttribute('role', 'option');
      a.setAttribute('aria-selected', i === 0 ? 'true' : 'false');

      const title = document.createElement('span');
      title.className = 'search-item__title';
      title.textContent = item.title;

      const ctx = document.createElement('span');
      ctx.className = 'search-item__ctx';
      ctx.textContent =
        item.kind === 'page' ? item.group : [item.group, sectionLabel].filter(Boolean).join(' · ');

      const snip = document.createElement('span');
      snip.className = 'search-item__snip';
      snip.textContent = token ? snippet(item.text, token) : item.text.slice(0, 72);

      a.append(title, ctx, snip);
      li.append(a);
      list.append(li);
    });
  }

  function move(delta: number) {
    if (!list || results.length === 0) return;
    const nodes = Array.from(list.querySelectorAll<HTMLAnchorElement>('.search-item'));
    nodes[cursor]?.setAttribute('aria-selected', 'false');
    cursor = (cursor + delta + nodes.length) % nodes.length;
    const active = nodes[cursor]!;
    active.setAttribute('aria-selected', 'true');
    active.scrollIntoView({ block: 'nearest' });
  }

  function open() {
    if (!dialog) return;
    if (!dialog.open) dialog.showModal();
    input?.focus();
    input?.select();
    // 索引是打开时才拉的：拉回来之后必须按**当前**输入重画一次，
    // 否则「打开就开始打字」的那几个字符会落在空索引上，界面一直空着。
    void load().then(() => render(input?.value ?? ''));
  }

  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement | null)?.closest('[data-search-open]');
    if (trigger) {
      event.preventDefault();
      open();
    }
  });

  document.addEventListener('keydown', (event) => {
    const key = event.key.toLowerCase();
    if ((event.ctrlKey || event.metaKey) && key === 'k') {
      event.preventDefault();
      open();
    }
  });

  input?.addEventListener('input', () => render(input.value));

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      move(1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      move(-1);
    } else if (event.key === 'Enter') {
      event.preventDefault();
      const active = list?.querySelector<HTMLAnchorElement>('.search-item[aria-selected="true"]');
      if (active) window.location.href = active.href;
    }
  });

  dialog?.addEventListener('close', () => {
    if (input) input.value = '';
  });
</script>
